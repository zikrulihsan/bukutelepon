# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase connection strings)
DATABASE_URL=
DIRECT_URL=

# App
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://carikontak.com

# Client env (set in Netlify)
# VITE_API_URL=https://your-railway-app.up.railway.app/api
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Contribution wall
GUEST_VIEW_THRESHOLD=3

# Password reset — these must be registered in Supabase Dashboard
# (Authentication > URL Configuration > Redirect URLs), otherwise the
# reset email falls back to Site URL instead of the reset page:
#   http://localhost:5173/reset-password
#   https://carikontak.com/reset-password
