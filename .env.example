# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase connection strings)
DATABASE_URL=
DIRECT_URL=

# App
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://carikontak.com

# ── Region (one deployment = one city, with its own database) ──
# Read by the client build AND the API server, so set them for both
# (on Netlify: scope Builds + Functions). Public values, not secrets.
# Leaving them empty falls back to the original Sumbawa Besar instance.
VITE_APP_NAME=
VITE_APP_TAGLINE=
VITE_APP_DESCRIPTION=
VITE_APP_URL=
VITE_THEME_COLOR=
VITE_REGION_NAME=
VITE_REGION_SLUG=
VITE_REGION_PROVINCE=
# International format, digits only, e.g. 6281234567890
VITE_ADMIN_WHATSAPP=
# Optional: fallback hero image path under client/public or an HTTPS URL
VITE_HERO_IMAGE=

# Client env (set in Netlify)
# Leave VITE_API_URL empty on Netlify: the API is served on the same domain at /api.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Contribution wall
GUEST_VIEW_THRESHOLD=3

# Password reset — these must be registered in Supabase Dashboard
# (Authentication > URL Configuration > Redirect URLs), otherwise the
# reset email falls back to Site URL instead of the reset page:
#   http://localhost:5173/reset-password
#   https://carikontak.com/reset-password
