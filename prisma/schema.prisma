generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountPlan {
  FREE
  PRO
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  HIDDEN
}

enum StorefrontItemType {
  PRODUCT
  SERVICE
  PACKAGE
  PROMO
}

enum StorefrontPriceType {
  FIXED
  STARTING_FROM
  CONTACT
  FREE
}

enum StorefrontItemStatus {
  ACTIVE
  HIDDEN
  SOLD_OUT
}

enum CatalogLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrustLevel {
  UNVERIFIED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ID_VERIFIED
}

enum ContactStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Profile {
  id             String      @id
  email          String      @unique
  name           String
  phone          String?     @unique
  role           Role        @default(USER)
  plan           AccountPlan @default(FREE)
  trustLevel     TrustLevel  @default(UNVERIFIED)
  hasContributed Boolean     @default(false)
  contributedAt  DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contacts        Contact[] @relation("SubmittedContacts")
  claimedContacts Contact[] @relation("ClaimedContacts")
  reviews         Review[]
  business        Business?

  @@map("profiles")
}

model Business {
  id                String         @id @default(uuid())
  ownerId           String         @unique
  name              String
  slug              String         @unique
  description       String         @db.VarChar(1000)
  whatsapp          String
  alternateWhatsapp String?
  instagram         String?
  address           String?        @db.VarChar(500)
  mapsUrl           String?
  openingHours      String?
  logoUrl           String?
  coverUrl          String?
  status            BusinessStatus @default(DRAFT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  owner              Profile             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items              StorefrontItem[]
  contact            Contact?            @relation("CatalogContact")
  catalogLinkRequest CatalogLinkRequest?

  @@index([status])
  @@map("businesses")
}

model StorefrontItem {
  id               String               @id @default(uuid())
  businessId       String
  type             StorefrontItemType   @default(PRODUCT)
  name             String
  slug             String
  shortDescription String               @db.VarChar(240)
  description      String               @db.VarChar(2000)
  category         String
  price            Int                  @default(0)
  priceType        StorefrontPriceType  @default(CONTACT)
  unit             String?
  imageUrl         String?
  badge            String?
  status           StorefrontItemStatus @default(ACTIVE)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId, status, sortOrder])
  @@map("storefront_items")
}

model GuestSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  ipAddress    String?
  viewCount    Int      @default(0)
  lastSeen     DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("guest_sessions")
}

model City {
  id        String   @id @default(uuid())
  name      String
  province  String
  slug      String   @unique
  createdAt DateTime @default(now())

  contacts Contact[]

  @@map("cities")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  contacts Contact[]

  @@map("categories")
}

model Contact {
  id              String        @id @default(uuid())
  name            String
  phone           String
  address         String?
  description     String?       @db.VarChar(500)
  descriptionEn   String?       @db.VarChar(500)
  website         String?
  mapsUrl         String?
  status          ContactStatus @default(PENDING)
  rejectionReason String?
  avgRating       Float         @default(0)
  reviewCount     Int           @default(0)
  cityId          String
  categoryId      String
  submittedById   String
  imageUrl        String?
  isVerified      Boolean       @default(false)
  claimedById     String?
  businessId      String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  city        City     @relation(fields: [cityId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  submittedBy Profile  @relation("SubmittedContacts", fields: [submittedById], references: [id])
  claimedBy   Profile? @relation("ClaimedContacts", fields: [claimedById], references: [id])
  business    Business? @relation("CatalogContact", fields: [businessId], references: [id], onDelete: SetNull)
  catalogLinkRequests CatalogLinkRequest[]
  reviews     Review[]

  @@index([cityId])
  @@index([categoryId])
  @@index([status])
  @@map("contacts")
}

model CatalogLinkRequest {
  id        String            @id @default(uuid())
  businessId String            @unique
  contactId String
  status    CatalogLinkStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, status])
  @@index([status, createdAt])
  @@map("catalog_link_requests")
}

model CollectionVersion {
  key       String   @id
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("collection_versions")
}

model Review {
  id              String       @id @default(uuid())
  rating          Int
  comment         String?      @db.VarChar(500)
  status          ReviewStatus @default(PENDING)
  rejectionReason String?
  contactId       String
  authorId        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id])
  author  Profile @relation(fields: [authorId], references: [id])

  @@unique([contactId, authorId])
  @@index([contactId])
  @@map("reviews")
}

model HeroPromotion {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(160)
  titleEn       String?  @db.VarChar(160)
  highlight     String?  @db.VarChar(160)
  highlightEn   String?  @db.VarChar(160)
  description   String   @db.VarChar(500)
  descriptionEn String?  @db.VarChar(500)
  imageUrl      String   @db.VarChar(2048)
  href          String   @db.VarChar(2048)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("hero_promotions")
}
